# hollow SearXNG 部署配置(Beijing 生产 · 串 Tokyo 出海)—— 2026-07-16
# 部署:本地 Python 进程直跑 vendor/searxng(不依赖 Docker)
use_default_settings: true

general:
  debug: false
  instance_name: "hollow-search"
  enable_metrics: true

server:
  secret_key: "268e879bed20e807f0547d78e5f482f55c02066b318e9f31a2f6334c87cf02a1"
  bind_address: "127.0.0.1"
  port: 8888
  limiter: false          # 内部可信调用方,限流放网关层(免 valkey)
  public_instance: false
  base_url: false

search:
  formats:
    - json                # ★开 JSON API,否则 format=json 一律 403
    - html
  safe_search: 0

ui:
  default_locale: "en"    # 固定错误文案语言,稳住 unresponsive_engines 解析

outgoing:
  request_timeout: 6.0
  max_request_timeout: 15.0
  # ★分流(串起来核心):无全局代理。
  #   国内引擎(baidu/sogou/quark)Beijing 原生直出(快、无验证码);
  #   国际引擎(被墙)按引擎单独走 Tokyo forward proxy —— 见下方 engines。

# use_default_settings=true 下,engines 按 name 合并覆盖默认项:
# 只给国际引擎加 proxies → 走 Tokyo(10.88.0.1:8899,经 wg 隧道);其余引擎默认直出。
engines:
  - name: duckduckgo
    proxies:
      http:  http://10.88.0.1:8899
      https: http://10.88.0.1:8899
  - name: wikipedia
    proxies:
      http:  http://10.88.0.1:8899
      https: http://10.88.0.1:8899
  - name: arxiv
    proxies:
      http:  http://10.88.0.1:8899
      https: http://10.88.0.1:8899
