# hollow SearXNG(Beijing 生产 · 串 Tokyo)—— 引擎路由按 2026-07-16 双 IP 矩阵重配
use_default_settings: true
general: {debug: false, instance_name: "hollow-search", enable_metrics: true}
server:
  secret_key: "268e879bed20e807f0547d78e5f482f55c02066b318e9f31a2f6334c87cf02a1"
  bind_address: "127.0.0.1"
  port: 8888
  limiter: false
  public_instance: false
  base_url: false
search:
  formats: [json, html]
  safe_search: 0
ui:
  default_locale: "en"
outgoing:
  request_timeout: 6.0
  max_request_timeout: 15.0
# 分流(矩阵实测):下列引擎 Beijing 直连不通、经 Tokyo 出海可用 → 单独走 Tokyo 代理。
# 其余(垂直源 arxiv/github/stackoverflow… + 国内 baidu/sogou/quark)默认直连,不代理。
