# 复制到 /etc/hollow/gateway.env 并 chmod 600。systemd EnvironmentFile 从这里读机密。
# 生成强 key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
HOLLOW_API_KEY=CHANGE_ME_use_a_32byte_random_key
